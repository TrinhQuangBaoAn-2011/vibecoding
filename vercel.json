{
  "version": 2,
  "cleanUrls": false,
  "builds": [
    { "src": "webcheck/api/fetch.mjs", "use": "@vercel/node" },
    { "src": "webcheck/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/fetch", "dest": "webcheck/api/fetch.mjs" },
    { "src": "/webcheck/(.*)", "dest": "/webcheck/$1" },
    { "src": "/", "dest": "/webcheck/index.html" },
    { "src": "/(.*)", "dest": "/webcheck/$1" }
  ]
}
